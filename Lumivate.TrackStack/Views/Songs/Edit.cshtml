@* TODO: Add a @model directive for a single Song *@
@* Hint: @model Lumivate.TrackStack.Models.Song *@
@model Lumivate.TrackStack.Models.Song

@{
    ViewData["Title"] = "Edit Song";
}

<h1>Edit Song</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            @* TODO: Add a hidden input for the Id *@
            @* Hint: <input type="hidden" asp-for="Id" /> *@
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label class="form-label">Title</label>
                @* TODO: Add an input tag helper for Title *@
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Duration (seconds)</label>
                @* TODO: Add an input tag helper for DurationSeconds *@
                <input asp-for="DurationSeconds" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Artist</label>
                @* TODO: Add a <select> dropdown for ArtistId *@
                @* Same pattern as the Create view - loop through ViewBag.Artists *@
                @* The current artist should be pre-selected (asp-for handles this) *@
                <select asp-for="ArtistId" class="form-select">
                    <option value="">-- Select an Artist --</option>
                    @foreach (var artist in ViewBag.Artists)
                    {
                        <option value="@artist.Id">@artist.Name</option>
                    }
                </select>
            </div>
            @* TODO: Add a submit button *@
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
