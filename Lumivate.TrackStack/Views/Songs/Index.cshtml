@* TODO: Add a @model directive for a List of Song *@
@* Hint: @model List<Lumivate.TrackStack.Models.Song> *@
@model List<Lumivate.TrackStack.Models.Song>

@{
    ViewData["Title"] = "Songs";
}

<h1>All Songs</h1>

<p>
    @* TODO: Add an anchor tag helper that links to the Create action *@
    <a asp-action="Create" class="btn btn-primary">Add New Song</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Artist</th>
            <th>Duration</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @* TODO: Add a @foreach loop to iterate over Model *@
        @* For each song, create a table row with: *@
        @*   - song.Title *@
        @*   - song.Artist?.Name (the artist's name via navigation property) *@
        @*   - song.DurationSeconds (display as-is, or format as mm:ss for a challenge) *@
        @*   - Links for Details, Edit, and Delete *@
        @foreach (var song in Model)
        {
            <tr>
                <td>@song.Title</td>
                <td>@song.Artist?.Name</td>
                <td>@song.DurationSeconds</td>
                <td>
                    <a asp-action="Details" asp-route-id="@song.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@song.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@song.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
