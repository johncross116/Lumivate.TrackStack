@{
    ViewData["Title"] = "Home Page";
}

<div class="music-hero text-center">
    <div class="vinyl-spin" aria-hidden="true">&#x1F3B5;</div>
    <h1 class="display-4" style="color: white;">Welcome to TrackStack!</h1>
    <p class="lead">Your personal jukebox. Browse artists and discover songs.</p>
</div>

<div class="row mt-4">
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div style="font-size: 2.5rem;">&#x1F3A4;</div>
                <h3 class="mt-2">Artists</h3>
                <p class="text-muted">Browse and manage your favorite artists.</p>
                <a asp-controller="Artists" asp-action="Index" class="btn btn-primary">View Artists</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div style="font-size: 2.5rem;">&#x1F3B6;</div>
                <h3 class="mt-2">Songs</h3>
                <p class="text-muted">Explore the full track list.</p>
                <a asp-controller="Songs" asp-action="Index" class="btn btn-primary">View Songs</a>
            </div>
        </div>
    </div>
</div>

<div class="music-wave" aria-hidden="true">&#x1F3B5; &#x1F3B6; &#x1F3B5; &#x1F3B6; &#x1F3B5;</div>
