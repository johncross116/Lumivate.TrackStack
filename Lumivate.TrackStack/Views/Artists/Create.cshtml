@* TODO: Add a @model directive for a single Artist *@
@* Hint: @model Lumivate.TrackStack.Models.Artist *@
@model Lumivate.TrackStack.Models.Artist

@{
    ViewData["Title"] = "Add New Artist";
}

<h1>Add New Artist</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label">Name</label>
                @* TODO: Add an input tag helper for Name *@
                @* Hint: <input asp-for="Name" class="form-control" /> *@
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Genre</label>
                @* TODO: Add an input tag helper for Genre *@
                <input asp-for="Genre" class="form-control" />
            </div>
            @* TODO: Add a submit button *@
            @* Hint: <button type="submit" class="btn btn-primary">Create</button> *@
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
