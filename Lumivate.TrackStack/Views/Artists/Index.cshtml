@* TODO: Add a @model directive for a List of Artist *@
@* Hint: @model List<Lumivate.TrackStack.Models.Artist> *@
@model List<Lumivate.TrackStack.Models.Artist>

@{
    ViewData["Title"] = "Artists";
}

<h1>Artists</h1>

<p>
    @* TODO: Add an anchor tag helper that links to the Create action *@
    @* Hint: <a asp-action="Create">Add New Artist</a> *@
    <a asp-action="Create" class="btn btn-primary">Add New Artist</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Genre</th>
            <th>Songs</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @* TODO: Add a @foreach loop to iterate over Model *@
        @* For each artist, create a table row with: *@
        @*   - artist.Name *@
        @*   - artist.Genre *@
        @*   - artist.Songs?.Count (number of songs) *@
        @*   - Links for Details, Edit, and Delete *@
        @*     Hint: <a asp-action="Details" asp-route-id="@artist.Id">Details</a> *@
        @foreach (var artist in Model)
        {
            <tr>
                <td>@artist.Name</td>
                <td>@artist.Genre</td>
                <td>@artist.Songs?.Count</td>
                <td>
                    <a asp-action="Details" asp-route-id="@artist.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@artist.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@artist.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
